    <rdf:rest rdf:nodeID="nc4795cc9bc9b4d26be6ac1b15713ec75b14"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc4795cc9bc9b4d26be6ac1b15713ec75b12">
    <rdf:first rdf:resource="https://w3id.org/arsipkg/ontology/v1#Peraturan"/>
    <rdf:rest rdf:nodeID="nc4795cc9bc9b4d26be6ac1b15713ec75b13"/>
  </rdf:Description>
